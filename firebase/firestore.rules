rules_version = '2';

// Regras do painel do treinador (docs/painel-web.md). Testadas em web/tests/rules.test.ts.
//
// - Cada atleta é a dona da própria ficha (athletes/{uid}, uid da conta anônima do app).
// - Treinador só entra com um código de pareamento válido gerado no celular dela, e só se põe a si mesmo.
// - Plano: atleta e treinadores leem e escrevem. Histórico e peso: só a atleta escreve; o treinador lê.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(athleteId) {
      return signedIn() && request.auth.uid == athleteId;
    }

    function isCoach(athleteId) {
      let athlete = get(/databases/$(database)/documents/athletes/$(athleteId));
      return signedIn() && athlete != null && request.auth.uid in athlete.data.get('coaches', {});
    }

    // Só o próprio treinador muda (o mapa de treinadores), e só a própria entrada.
    function onlyOwnCoachEntry() {
      return request.resource.data.get('coaches', {}).diff(resource.data.get('coaches', {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Pareamento: o código existe, é desta atleta e não expirou.
    function validPairing(athleteId) {
      let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.pairCode));
      let entry = request.resource.data.coaches[request.auth.uid];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coaches', 'pairCode'])
        && onlyOwnCoachEntry()
        && entry.keys().hasOnly(['name', 'email', 'addedAt'])
        && entry.name is string && entry.name.size() <= 100
        && invite.data.athleteId == athleteId
        && invite.data.expiresAt > request.time;
    }

    // Treinador saindo por conta própria.
    function leaving() {
      return request.auth.uid in resource.data.get('coaches', {})
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coaches'])
        && onlyOwnCoachEntry()
        && !(request.auth.uid in request.resource.data.get('coaches', {}));
    }

    function validPlan() {
      let plan = request.resource.data;
      return plan.schema == 2
        && plan.templates is map && plan.templates.size() <= 40
        && plan.week is map && plan.week.size() <= 7
        && plan.exercises is map && plan.exercises.size() <= 300
        && plan.deleted is map
        && plan.dates is map && plan.dates.size() <= 500
        && plan.updatedBy in ['app', 'web'];
    }

    match /athletes/{athleteId} {
      allow get: if isOwner(athleteId) || (signedIn() && request.auth.uid in resource.data.get('coaches', {}));
      allow list: if false;
      allow create: if isOwner(athleteId) && request.resource.data.ownerUid == athleteId
        && request.resource.data.get('coaches', {}).size() == 0;
      allow update: if (isOwner(athleteId) && request.resource.data.ownerUid == athleteId)
        || (signedIn() && validPairing(athleteId))
        || (signedIn() && leaving());
      allow delete: if isOwner(athleteId);

      match /plan/{docId} {
        allow read: if isOwner(athleteId) || isCoach(athleteId);
        allow create, update: if docId == 'current' && (isOwner(athleteId) || isCoach(athleteId)) && validPlan();
        allow delete: if isOwner(athleteId);
      }

      match /days/{day} {
        allow read: if isOwner(athleteId) || isCoach(athleteId);
        allow write: if isOwner(athleteId);
      }

      match /private/{docId} {
        allow read: if isOwner(athleteId) || isCoach(athleteId);
        allow write: if isOwner(athleteId);
      }
    }

    // Código de pareamento: quem tem o código lê (sem listar); só a dona cria; some depois de usado.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.size() == 8
        && request.resource.data.athleteId == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(2, 'h');
      allow delete: if signedIn();
    }

    // Lista de atletas de cada treinador.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
