<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: o histórico de treinos vai no backup do Google; o cache de vídeos não (refaz sozinho). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="myvitory.db" />
        <include domain="database" path="myvitory.db-wal" />
        <include domain="database" path="myvitory.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="myvitory.db" />
        <include domain="database" path="myvitory.db-wal" />
        <include domain="database" path="myvitory.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
