{
  "name": "myvitory-web",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulador": "vite --mode emulator",
    "emuladores": "firebase emulators:start --project demo-myvitory --config ../firebase.json",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:regras": "firebase emulators:exec --only firestore --project demo-myvitory --config ../firebase.json \"vitest run --config vitest.rules.config.ts\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore --config ../firebase.json",
    "publicar-app": "node scripts/publicar-app.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
